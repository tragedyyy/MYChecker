{
  "name": "mychecker",
  "version": "1.0.0",
  "description": "Multi-chain crypto address derivation and balance checker for 36 networks, with corrected TON, Polkadot, Cardano, Sui and Aptos support",
  "type": "module",
  "main": "mychecker.ts",
  "bin": {
    "mychecker": "./mychecker.ts"
  },
  "files": [
    "mychecker.ts",
    "src/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun mychecker.ts",
    "check": "bun mychecker.ts --check",
    "smoke": "bun mychecker.ts --help"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@cosmjs/amino": "^0.32.0",
    "@cosmjs/crypto": "^0.32.0",
    "@cosmjs/encoding": "^0.32.0",
    "@emurgo/cardano-serialization-lib-nodejs": "^17.0.0",
    "@polkadot/util": "^14.0.3",
    "@polkadot/util-crypto": "^14.0.3",
    "@scure/bip32": "^1.3.0",
    "@solana/web3.js": "^1.95.0",
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.3.0",
    "base32-encode": "^2.0.0",
    "bech32": "^2.0.0",
    "bip39": "^3.1.0",
    "bitcoinjs-lib": "^6.1.0",
    "bs58": "^6.0.0",
    "ecpair": "^2.1.0",
    "ed25519-hd-key": "^1.3.0",
    "ethers": "^6.13.0",
    "ripple-keypairs": "^2.0.0",
    "stellar-base": "^11.0.0",
    "tiny-secp256k1": "^2.2.3",
    "tweetnacl": "^1.0.3"
  },
  "keywords": [
    "cryptocurrency",
    "wallet",
    "bitcoin",
    "ethereum",
    "solana",
    "tron",
    "ton",
    "cosmos",
    "polkadot",
    "cardano",
    "blockchain",
    "address",
    "balance",
    "mnemonic",
    "bip39",
    "cli"
  ],
  "license": "MIT"
}
